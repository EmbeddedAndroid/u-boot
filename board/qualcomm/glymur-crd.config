# Glymur CRD with TF-A as the boot firmware; use with qcom_defconfig and
# tfa-optee.config.
CONFIG_DEFAULT_DEVICE_TREE="qcom/glymur-crd"
CONFIG_OF_BOARD_SETUP=y
CONFIG_PCI=y
CONFIG_PCIE_DW_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_NVME_PCI=y
CONFIG_CMD_PCI=y
CONFIG_CMD_NVME=y
CONFIG_ARM_SMMU_V3_BYPASS=y
