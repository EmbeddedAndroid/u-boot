# SecaAU Ride SX booted by TF-A (BL33), local devicetree until the Linux
# one is in dts/upstream. Fastboot over USB0, entered by volume down.
# CONFIG_OF_UPSTREAM is not set
CONFIG_DEFAULT_DEVICE_TREE="seca-ride-sx"
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/seca-ride-sx.env"
CONFIG_PINCTRL_QCOM_NORD=y
CONFIG_BUTTON=y
CONFIG_BUTTON_GPIO=y
CONFIG_CMD_BUTTON=y
CONFIG_FASTBOOT_FLASH_BLOCK=y
CONFIG_FASTBOOT_FLASH_BLOCK_INTERFACE_NAME="scsi"
CONFIG_FASTBOOT_FLASH_BLOCK_DEVICE_ID=0
CONFIG_FASTBOOT_OEM_RUN=y
