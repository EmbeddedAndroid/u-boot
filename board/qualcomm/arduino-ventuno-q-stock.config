# Arduino VENTUNO Q on the stock boot chain (XBL, QTEE, Gunyah). Use with
# qcom_qcs8300_defconfig, which enables the Gunyah exit hook: U-Boot leaves
# Gunyah, runs at EL2 and moves to the first Cortex-A55 before Linux.
CONFIG_DEFAULT_DEVICE_TREE="qcom/monaco-arduino-monza"
CONFIG_BOOT0_QCOM_BOOT_CPU=y
CONFIG_QCOM_BOOT_CPU_MPIDR=0x10000
