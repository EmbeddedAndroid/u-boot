stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
fastboot=fastboot -l $fastboot_addr_r usb 0

# The boot drive is an NVMe behind PCIe. bootstd's NVMe hunter enumerates
# PCI and scans the namespaces before the EFI boot manager runs; on its own
# the boot manager only sees block devices that already exist. Without the
# efi bootmeth the boot manager decides, including the removable-media
# fallback, unless an extlinux.conf boots first. extlinux is the normal
# bootmeth that drives the hunt: with only efi_mgr the scan would start
# with it, before any bootdev is hunted.
bootmeths=extlinux efi_mgr
do_boot=bootflow scan -lb

bootmenu_0=Boot first available device=run do_boot
bootmenu_1=Enable fastboot mode=run fastboot
bootmenu_2=Reset device=reset
menucmd=bootmenu
bootcmd=run do_boot
