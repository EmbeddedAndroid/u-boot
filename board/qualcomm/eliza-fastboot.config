# Eliza MTP: fastboot over the USB gadget, flashing UFS LUN0 partitions,
# entered by holding volume down while U-Boot starts.
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/eliza-fastboot.env"
CONFIG_FASTBOOT_FLASH_BLOCK=y
CONFIG_FASTBOOT_FLASH_BLOCK_INTERFACE_NAME="scsi"
CONFIG_FASTBOOT_FLASH_BLOCK_DEVICE_ID=0
CONFIG_FASTBOOT_OEM_RUN=y
